{
  "name": "fintech-coach-app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@supabase/supabase-js": "^2.112.3",
    "expo": "~57.0.15",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-plaid-link-sdk": "^13.0.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "react-plaid-link": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "android:devbuild": "expo run:android",
    "ios:devbuild": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web",
    "check": "npm run typecheck && npm run build:web",
    "supabase:login": "npx supabase@latest login",
    "supabase:link": "npx supabase@latest link",
    "supabase:db:push": "npx supabase@latest db push",
    "supabase:functions:serve": "npx supabase@latest functions serve --env-file supabase/.env",
    "supabase:functions:deploy": "npx supabase@latest functions deploy --use-api"
  },
  "private": true
}
